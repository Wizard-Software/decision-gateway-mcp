{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-10-17/server.schema.json",
  "name": "io.github.Wizard-Software/decision-gateway-mcp",
  "description": "MCP server (stdio) that gates decisions.",
  "version": "0.0.1-spike",
  "packages": [
    {
      "registryType": "nuget",
      "registryBaseUrl": "https://api.nuget.org",
      "identifier": "DecisionGateway.Mcp",
      "version": "0.0.1-spike",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "JEV_API_KEY",
          "description": "API key of the JEV provider.",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "OPENAI_API_KEY",
          "description": "API key of the OpenAI provider.",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
